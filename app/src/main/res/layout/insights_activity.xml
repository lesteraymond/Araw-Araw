<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".InsightsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg"
        android:orientation="vertical">

        <!-- Top Bar -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="20dp"
            android:layout_marginBottom="10dp">

            <ImageButton
                android:id="@+id/nav_menu_btn"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/hamburger_menu_icon" />

            <TextView
                android:id="@+id/title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:fontFamily="sans-serif"
                android:text="Araw-Araw"
                android:textColor="@color/font_color_blue"
                android:textSize="24sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/refresh_btn"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:background="@drawable/ic_refresh" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/middle_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Activity Forecast"
                        android:textColor="@color/font_color_dark"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Plan your week based on the weather's personality."
                        android:textColor="@color/font_color_dark"
                        android:textSize="14sp" />

                    <!-- Today's Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/rounded_stroke_main_bg"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:id="@+id/today_day_textv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="@color/font_color_blue"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/today_suggestion_pill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:background="@drawable/bg_pill_laundry"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:text=""
                                android:textColor="@color/font_color_dark"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                tools:visibility="visible" />
                        </RelativeLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical">
                            <TextView
                                android:id="@+id/today_temp_textv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/font_color_dark"
                                android:textSize="60sp"
                                android:fontFamily="serif"
                                android:textStyle="bold" />
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="15dp"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/today_description_textv"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    android:textColor="@color/font_color_dark_blue"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/today_sub_description_textv"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    android:textColor="@color/font_color_dark"
                                    android:textSize="9sp" />
                            </LinearLayout>
                            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                            <ImageView
                                android:id="@+id/today_weather_ic"
                                android:layout_width="60dp"
                                android:layout_height="60dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp">
                            <!-- Stats here... keeping it simple -->
                            <TextView
                                android:id="@+id/today_humidity_textv"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Humidity\n--"
                                android:gravity="center"
                                android:textColor="@color/font_color_dark"
                                android:background="@drawable/rounded_main_bg"
                                android:padding="10dp" />
                            <View android:layout_width="10dp" android:layout_height="0dp" />
                            <TextView
                                android:id="@+id/today_wind_textv"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Wind\n--km"
                                android:textColor="@color/font_color_dark"
                                android:gravity="center"
                                android:background="@drawable/rounded_main_bg"
                                android:padding="10dp" />
                            <View android:layout_width="10dp" android:layout_height="0dp" />
                            <TextView
                                android:id="@+id/today_uv_textv"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="UV\n--"
                                android:textColor="@color/font_color_dark"
                                android:gravity="center"
                                android:background="@drawable/rounded_main_bg"
                                android:padding="10dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Upcoming Days"
                        android:textColor="@color/font_color_dark"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Day 1 -->
                    <LinearLayout
                        android:id="@+id/day1_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/rounded_stroke_main_bg"
                        android:gravity="center_vertical"
                        android:padding="12dp">
                        <TextView
                            android:id="@+id/day1_name_textv"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="..."
                            android:textStyle="bold" />
                        <ImageView
                            android:id="@+id/day1_weather_ic"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_weather_sunny" />
                        <TextView
                            android:id="@+id/day1_temp_textv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="--°" />
                        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                        <TextView
                            android:id="@+id/day1_suggestion_textv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_picnic"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:text="..."
                            android:textColor="@color/font_color_blue"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Day 2 -->
                    <LinearLayout
                        android:id="@+id/day2_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/rounded_stroke_main_bg"
                        android:gravity="center_vertical"
                        android:padding="12dp">
                        <TextView
                            android:id="@+id/day2_name_textv"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="..."
                            android:textStyle="bold" />
                        <ImageView
                            android:id="@+id/day2_weather_ic"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_weather_sunny" />
                        <TextView
                            android:id="@+id/day2_temp_textv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="--°" />
                        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                        <TextView
                            android:id="@+id/day2_suggestion_textv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_laundry"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:text="..."
                            android:textColor="@color/font_color_dark"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Day 3 -->
                    <LinearLayout
                        android:id="@+id/day3_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/rounded_stroke_main_bg"
                        android:gravity="center_vertical"
                        android:padding="12dp">
                        <TextView
                            android:id="@+id/day3_name_textv"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="..."
                            android:textStyle="bold" />
                        <ImageView
                            android:id="@+id/day3_weather_ic"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_weather_sunny" />
                        <TextView
                            android:id="@+id/day3_temp_textv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="--°" />
                        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                        <TextView
                            android:id="@+id/day3_suggestion_textv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_laundry"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:text="..."
                            android:textColor="@color/font_color_dark"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Day 4 -->
                    <LinearLayout
                        android:id="@+id/day4_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/rounded_stroke_main_bg"
                        android:gravity="center_vertical"
                        android:padding="12dp">
                        <TextView
                            android:id="@+id/day4_name_textv"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="..."
                            android:textStyle="bold" />
                        <ImageView
                            android:id="@+id/day4_weather_ic"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_weather_sunny" />
                        <TextView
                            android:id="@+id/day4_temp_textv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="--°" />
                        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                        <TextView
                            android:id="@+id/day4_suggestion_textv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_laundry"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:text="..."
                            android:textColor="@color/font_color_dark"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Day 5 -->
                    <LinearLayout
                        android:id="@+id/day5_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/rounded_stroke_main_bg"
                        android:gravity="center_vertical"
                        android:padding="12dp">
                        <TextView
                            android:id="@+id/day5_name_textv"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="..."
                            android:textStyle="bold" />
                        <ImageView
                            android:id="@+id/day5_weather_ic"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_weather_sunny" />
                        <TextView
                            android:id="@+id/day5_temp_textv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="--°" />
                        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                        <TextView
                            android:id="@+id/day5_suggestion_textv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_laundry"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:text="..."
                            android:textColor="@color/font_color_dark"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Day 6 -->
                    <LinearLayout
                        android:id="@+id/day6_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/rounded_stroke_main_bg"
                        android:gravity="center_vertical"
                        android:padding="12dp">
                        <TextView
                            android:id="@+id/day6_name_textv"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="..."
                            android:textStyle="bold" />
                        <ImageView
                            android:id="@+id/day6_weather_ic"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_weather_sunny" />
                        <TextView
                            android:id="@+id/day6_temp_textv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="--°" />
                        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                        <TextView
                            android:id="@+id/day6_suggestion_textv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_laundry"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:text="..."
                            android:textColor="@color/font_color_dark"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Day 7 -->
                    <LinearLayout
                        android:id="@+id/day7_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/rounded_stroke_main_bg"
                        android:gravity="center_vertical"
                        android:padding="12dp">
                        <TextView
                            android:id="@+id/day7_name_textv"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="..."
                            android:textStyle="bold" />
                        <ImageView
                            android:id="@+id/day7_weather_ic"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_weather_sunny" />
                        <TextView
                            android:id="@+id/day7_temp_textv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="--°" />
                        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                        <TextView
                            android:id="@+id/day7_suggestion_textv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_laundry"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:text="..."
                            android:textColor="@color/font_color_dark"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- AI Recommendation Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="25dp"
                        android:background="@drawable/rounded_stroke_blue"
                        android:backgroundTint="#F0F9FF"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">
                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="@drawable/bg_mic_button"
                                    android:backgroundTint="@color/white"
                                    android:padding="6dp"
                                    android:src="@drawable/ic_ai_stars"
                                    app:tint="@color/font_color_blue" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:text="Best Time This Week"
                                    android:textColor="@color/font_color_dark"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/bg_pill_picnic"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text="AI GENERATED"
                                android:textColor="@color/font_color_blue"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05" />
                        </RelativeLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp">

                            <!-- Laundry Recommendation -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/rounded_stroke_main_bg"
                                android:padding="16dp"
                                android:elevation="1dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="FOR LAUNDRY"
                                    android:textSize="10sp"
                                    android:textColor="@color/font_color_blue"
                                    android:textStyle="bold"
                                    android:alpha="0.8" />
                                <TextView
                                    android:id="@+id/best_laundry_day"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Analyzing..."
                                    android:textColor="@color/font_color_dark"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/best_laundry_reason"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Finding the best sun..."
                                    android:textColor="@color/font_color_dark"
                                    android:textSize="10sp"
                                    android:alpha="0.7" />
                            </LinearLayout>

                            <View android:layout_width="12dp" android:layout_height="0dp" />

                            <!-- Outdoor Recommendation -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/rounded_stroke_main_bg"
                                android:padding="16dp"
                                android:elevation="1dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="FOR OUTDOOR"
                                    android:textSize="10sp"
                                    android:textColor="@color/font_color_blue"
                                    android:textStyle="bold"
                                    android:alpha="0.8" />
                                <TextView
                                    android:id="@+id/best_outdoor_day"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Analyzing..."
                                    android:textColor="@color/font_color_dark"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/best_outdoor_reason"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Finding cool breeze..."
                                    android:textColor="@color/font_color_dark"
                                    android:textSize="10sp"
                                    android:alpha="0.7" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Powered by Araw-Araw AI • Tailored to your local forecast"
                            android:textColor="@color/font_color_blue"
                            android:textSize="10sp"
                            android:gravity="center"
                            android:alpha="0.6" />
                    </LinearLayout>

                    <!-- Footer Insight Card -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="140dp"
                        android:layout_marginTop="25dp"
                        android:layout_marginBottom="80dp"
                        android:background="@drawable/bg_footer_insight"
                        android:padding="24dp"
                        android:elevation="4dp">

                        <!-- Background Sun Icon -->
                        <ImageView
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:layout_marginTop="-15dp"
                            android:layout_marginEnd="-15dp"
                            android:alpha="0.15"
                            android:src="@drawable/ic_weather_sunny"
                            app:tint="@color/white" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/footer_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Maximize the Sun"
                                android:textColor="@color/white"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="We predict 48 hours of uninterrupted drying weather ahead. Perfect for large laundry batches!"
                                android:textColor="@color/white"
                                android:textSize="15sp"
                                android:lineSpacingExtra="4dp"
                                android:alpha="0.9" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="20dp"
                                android:text="View drying tips →"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:alpha="0.8" />
                        </LinearLayout>
                    </RelativeLayout>
                </LinearLayout>
            </ScrollView>

            <!-- Steady AI Icon Star -->
            <ImageButton
                android:id="@+id/ai_star_btn"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="20dp"
                android:background="@drawable/bg_mic_button"
                android:src="@drawable/ic_ai_stars"
                android:elevation="6dp" />
        </FrameLayout>

        <!-- BOTTOM NAVIGATION -->
        <LinearLayout
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="@color/white"
            android:elevation="8dp"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Home -->
            <LinearLayout
                android:id="@+id/nav_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/ic_home_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_home"
                    app:tint="@color/font_color_dark" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textSize="12sp"
                    android:textColor="@color/font_color_dark" />
            </LinearLayout>

            <!-- Insights -->
            <LinearLayout
                android:id="@+id/nav_insights"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="60dp"
                    android:layout_height="35dp"
                    android:background="@drawable/bg_nav_item_selected"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_insights"
                        app:tint="@color/white" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Insights"
                    android:textSize="12sp"
                    android:textColor="@color/nav_blue" />
            </LinearLayout>

            <!-- Settings -->
            <LinearLayout
                android:id="@+id/nav_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/ic_settings_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/font_color_dark" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textSize="12sp"
                    android:textColor="@color/font_color_dark" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- AI Chat Overlay -->
    <include layout="@layout/ai_chat_overlay" />

    <!-- Loading Overlay -->
    <FrameLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">
        <ProgressBar
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/white" />
    </FrameLayout>

    <!-- Include the navigation menu -->
    <include layout="@layout/navigation_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
